# Optional AI director. The default heuristic director needs no key.
LLM_PROVIDER=heuristic
OPENAI_API_KEY=
OPENAI_LLM_MODEL=gpt-5.2

# auto = local system voice when available, otherwise a silent mock track.
# Other values: system, openai, mock
TTS_PROVIDER=auto
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=cedar
OPENAI_TTS_INSTRUCTIONS=Speak clearly with an engaging documentary tone.

# Optional premium expressive voice with character-level timing.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_v3

# Optional Vietnamese-native voices: banmai, lannhi, leminh, myan, thuminh,
# giahuy, linhsan.
FPT_TTS_API_KEY=
FPT_TTS_VOICE=banmai
FPT_TTS_SPEED=0

# Optional self-hosted OpenAI-compatible Vietnamese TTS server.
# Works with servers such as dangvansam/viet-tts. The GitHub30 demo wrapper is
# intentionally not used because it relies on third-party demo endpoints.
LOCAL_TTS_BASE_URL=
LOCAL_TTS_API_KEY=
LOCAL_TTS_MODEL=tts-1
LOCAL_TTS_VOICE=nu-nhe-nhang
LOCAL_TTS_TIMEOUT_MS=120000

VIDEO_FPS=30
VIDEO_FORMAT=9:16
